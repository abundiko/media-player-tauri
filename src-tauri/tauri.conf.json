{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Caste",
  "version": "0.1.0",
  "identifier": "com.abundiko.caste",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caste",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' http://127.0.0.1:*; img-src 'self' http://127.0.0.1:* data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "abundiko",
    "copyright": "Copyright (c) 2024 abundiko",
    "shortDescription": "A desktop media player with custom controls, animated backgrounds, and equalizer",
    "longDescription": "Caste is a desktop-feel media player with custom controls, animated backgrounds, equalizer, resume playback, and native window behavior. Built with Tauri and React.",
    "licenseFile": "../LICENSE",
    "category": "Entertainment",
    "homepage": "https://github.com/abundiko/caste",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/caste-ffmpeg",
      "bin/caste-ffprobe"
    ],
    "fileAssociations": [
      {
        "name": "Media File",
        "description": "Caste Video and Audio File",
        "mimeType": "video/mp4",
        "ext": [
          "mp4", "mkv", "avi", "mov", "wmv", "flv", "webm", "m4v", "mpg", "mpeg",
          "mp3", "flac", "wav", "aac", "ogg", "opus", "m4a", "wma", "ac3", "dts"
        ]
      }
    ],
    "windows": {
      "allowDowngrades": true,
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
